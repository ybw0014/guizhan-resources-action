{
	"name": "guizhan-resources-action",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.2.0",
	"scripts": {
		"lint": "eslint src/**/*.ts tests/**/*.ts *.config.*",
		"lint:fix": "eslint src/**/*.ts tests/**/*.ts *.config.* --fix",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc --noEmit",
		"package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
		"actionlint": "github-actionlint .github/workflows/*.yml"
	},
	"dependencies": {
		"@actions/artifact": "2.3.2",
		"@actions/core": "1.11.1",
		"@actions/glob": "0.5.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "25.5.2",
		"@vercel/ncc": "0.38.4",
		"actionlint": "2.0.6",
		"eslint": "10.2.0",
		"github-actionlint": "1.7.12",
		"globals": "17.4.0",
		"typescript": "6.0.2",
		"typescript-eslint": "8.58.1",
		"vitest": "4.1.4"
	}
}
