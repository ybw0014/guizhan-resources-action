{
	"name": "guizhan-resources-action",
	"version": "0.1.2",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt src tests",
		"format:check": "oxfmt --check src tests",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc --noEmit",
		"package": "tsup src/index.ts --format cjs --target node24 --out-dir dist --no-splitting",
		"actionlint": "github-actionlint .github/workflows/*.yml"
	},
	"tsup": {
		"noExternal": [
			"@actions/artifact",
			"@actions/core",
			"@actions/glob"
		],
		"shims": true
	},
	"dependencies": {
		"@actions/artifact": "6.2.1",
		"@actions/core": "3.0.1",
		"@actions/glob": "0.7.0"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"actionlint": "2.0.6",
		"github-actionlint": "1.7.12",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"tsup": "8.5.1",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
